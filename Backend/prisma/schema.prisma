generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum ProductStatus {
  draft
  published
  archived
}

enum DiscountType {
  percentage
  fixed
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  online
}

enum StorageProvider {
  local
  cloudinary
  s3
}

enum NewsletterSource {
  footer
  checkout
  popup
  admin
  other
}

model User {
  id                        String    @id @default(uuid()) @db.Uuid
  name                      String    @db.VarChar(120)
  email                     String    @db.VarChar(254)
  passwordHash              String
  role                      Role      @default(CUSTOMER)
  isEmailVerified           Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  passwordResetToken        String?
  passwordResetExpires      DateTime?
  adminLoginChallengeId     String?
  adminLoginOtpHash         String?
  adminLoginOtpExpires      DateTime?
  addresses                 Json      @default("[]")
  refreshTokens             Json      @default("[]")
  lastLoginAt               DateTime?
  avatarUrl                 String?
  deletedAt                 DateTime?
  createdBy                 String?
  updatedBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  wishlistItems WishlistItem[]
  orders        Order[]

  @@index([role, deletedAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @db.VarChar(200)
  slug              String
  sku               String
  category          String
  price             Decimal       @db.Decimal(12, 2)
  originalPrice     Decimal?      @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  discountType      DiscountType  @default(percentage)
  description       Json          @default("{\"intro\":\"\",\"detail\":\"\",\"highlights\":[]}")
  specifications    Json          @default("{\"composition\":\"\",\"care\":\"\",\"includes\":\"\"}")
  returnPolicy      String        @default("") @db.VarChar(2000)
  sizes             Json          @default("[]")
  colors            Json          @default("[]")
  variants          Json          @default("[]")
  images            Json          @default("[]")
  bestSeller        Boolean       @default(false)
  stock             Int           @default(0)
  lowStockThreshold Int           @default(10)
  rating            Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount       Int           @default(0)
  status            ProductStatus @default(draft)
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  restockEvents RestockEvent[]

  @@index([category, status, deletedAt])
  @@index([bestSeller, status, deletedAt])
  @@index([status, stock, deletedAt])
  @@index([price, deletedAt])
  @@map("products")
}

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderNumber        String
  userId             String?       @db.Uuid
  customer           String
  email              String
  phone              String
  shipping           Json
  paymentMethod      PaymentMethod @default(cod)
  status             OrderStatus   @default(pending)
  subtotal           Decimal       @db.Decimal(12, 2)
  shippingFee        Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @db.Decimal(12, 2)
  taxRate            Decimal       @db.Decimal(8, 4)
  taxLabel           String        @default("GST")
  total              Decimal       @db.Decimal(12, 2)
  notes              String?
  cancelledAt        DateTime?
  cancellationReason String?
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  name      String
  sku       String
  quantity  Int
  size      String?
  color     String?
  colorHex  String?
  price     Decimal @db.Decimal(12, 2)
  imageUrl  String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StorefrontContent {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @default("default")
  isPublished       Boolean   @default(false)
  navigation        Json      @default("[]")
  heroSlides        Json      @default("[]")
  showcase          Json      @default("{}")
  collectionHeroes  Json      @default("{}")
  shopTheLook       Json      @default("{}")
  footerSocial      Json      @default("{}")
  authPages         Json      @default("{}")
  commerceSettings  Json      @default("{}")
  publishedAt       DateTime?
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isPublished])
  @@map("storefront_contents")
}

model MediaAsset {
  id              String          @id @default(uuid()) @db.Uuid
  filename        String
  originalName    String
  mimeType        String
  size            Int
  url             String
  storageProvider StorageProvider @default(local)
  storageKey      String?
  folder          String          @default("general")
  uploadedBy      String?
  metadata        Json?
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([folder])
  @@index([uploadedBy])
  @@index([mimeType])
  @@map("media_assets")
}

model NewsletterSubscriber {
  id             String           @id @default(uuid()) @db.Uuid
  email          String
  source         NewsletterSource @default(footer)
  subscribedAt   DateTime         @default(now())
  isActive       Boolean          @default(true)
  unsubscribedAt DateTime?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([isActive])
  @@map("newsletter_subscribers")
}

model RestockEvent {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sku           String
  quantity      Int
  note          String?  @db.VarChar(500)
  previousStock Int
  newStock      Int
  createdBy     String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("restock_events")
}
