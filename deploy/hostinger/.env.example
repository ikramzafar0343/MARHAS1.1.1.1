# MARHAS — Hostinger VPS production env
# Copy to: deploy/hostinger/.env  (never commit real secrets)
#
# Server:  srv2029499.hstgr.cloud  |  72.61.19.3  |  Ubuntu 24.04
# Domain:  marhas.pk  (Cloudflare A records → 72.61.19.3)
# DO NOT use the expired GoDaddy IP 132.148.73.92

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL inside Docker network (marhas-db). Password generated by setup script.
POSTGRES_USER=marhas
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=marhas
DATABASE_URL=postgresql://marhas:CHANGE_ME_POSTGRES_PASSWORD@db:5432/marhas?schema=public&connection_limit=10

# Generate on VPS: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_LONG_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_LONG_VALUE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://marhas.pk,https://www.marhas.pk
APP_URL=https://marhas.pk

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@marhas.pk
SMTP_PASS=CHANGE_ME_SUPPORT_MAILBOX_PASSWORD
EMAIL_FROM=MARHAS <support@marhas.pk>
SUPPORT_EMAIL=support@marhas.pk

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DIR=src/uploads
STORAGE_PROVIDER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

SEED_ADMIN_EMAIL=admin@marhas.com
SEED_ADMIN_PASSWORD=Marhas@Admin123
SEED_ADMIN_NAME=MARHAS Admin

SYNC_DEFAULT_MEDIA=false
