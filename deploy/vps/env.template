NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Local MongoDB on VPS (installed by setup-marhas.sh)
MONGODB_URI=mongodb://127.0.0.1:27017/marhas
DATABASE_NAME=marhas

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET

CORS_ORIGIN=https://marhas.pk,https://www.marhas.pk
APP_URL=https://marhas.pk

STORAGE_PROVIDER=local
UPLOAD_DIR=src/uploads
UPLOAD_MAX_FILE_SIZE=10485760

# Email (Hostinger — use support@marhas.pk mailbox password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@marhas.pk
SMTP_PASS=CHANGE_ME_EMAIL_PASSWORD
EMAIL_FROM=MARHAS <support@marhas.pk>
SUPPORT_EMAIL=support@marhas.pk

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
