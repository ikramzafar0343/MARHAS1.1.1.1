# Backend API base URL (must include /api/v1)
# Local development only — production builds use .env.production (/api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Backend host for uploaded media only (/uploads/...)
# CMS/seed paths under /assets/images/ are served by the frontend (public/)
VITE_ASSET_URL=http://localhost:5000
